# .env.example - Copy to .env for local development ONLY
# NEVER commit .env to git. It is in .gitignore.
# In production, all values marked [VAULT] are read from HashiCorp Vault.

# -- Orchestrator API --------------------------------------
ORCHESTRATOR_PORT=3001
NODE_ENV=development                         # Change to 'production' for prod
JWT_PUBLIC_KEY_PATH=/etc/dasdocker/keys/jwt.pub   # Path to RS256 public key PEM
RATE_LIMIT_WINDOW_MS=60000                   # Rate limit window (ms)
RATE_LIMIT_MAX_REQUESTS=5                    # Max session creates per IP per window
MAX_CONCURRENT_SESSIONS=50                   # Global concurrent session cap

# -- Redis --------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=                              # [VAULT] dasdocker/data/cache/redis_password

# -- HashiCorp Vault ---------------------------------------
VAULT_ADDR=https://127.0.0.1:8200
VAULT_TOKEN=                                 # [VAULT] Never hardcode - use AppRole auth

# -- Docker -------------------------------------------------
DOCKER_SOCKET=/var/run/docker.sock
DASDOCKER_NETWORK=dasdocker-isolated
SECCOMP_PROFILE_PATH=/etc/dasdocker/security/seccomp-dasdocker.json
APPARMOR_PROFILE=dasdocker-container

# -- ClamAV -------------------------------------------------
CLAMAV_SOCKET=/var/run/clamav/clamd.sock

# -- Event Bus ----------------------------------------------
EVENT_BUS_PORT=3002
EVENT_BUS_REDIS_STREAM_PREFIX=dasdocker:events

# -- Frontend -----------------------------------------------
VITE_API_BASE_URL=http://localhost:3001
VITE_WS_BASE_URL=ws://localhost:3002
